# Copy to .env for local development. Never commit .env.

APP_ENV=dev
# Local: SQLite. Azure (existing server):
#   postgresql+asyncpg://USER:PASSWORD@SERVER.postgres.database.azure.com:5432/DATABASE?ssl=require
DATABASE_URL=sqlite+aiosqlite:///./vanakkamiq.db
# PostgreSQL only: schema for VanakkamIQ tables inside a shared database (created if missing).
DATABASE_SCHEMA=
PUBLIC_BASE_URL=http://localhost:8000
SECRET_KEY=change-me-to-a-long-random-string

# OpenAI Realtime over SIP (platform.openai.com project settings)
OPENAI_API_KEY=
OPENAI_PROJECT_ID=
OPENAI_WEBHOOK_SECRET=
OPENAI_REALTIME_MODEL=gpt-realtime-2.1
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-transcribe

# Telnyx (SMS). Leave empty to log SMS instead of sending.
TELNYX_API_KEY=

# Passwordless sign-in: one-time codes emailed through Azure Communication Services.
# Leave empty locally: with APP_ENV=dev the code is printed in the server log instead.
ACS_CONNECTION_STRING=
ACS_SENDER=DoNotReply@nativemindsai.com
# Local dev only: use this fixed code instead of a random one (ignored unless APP_ENV=dev without email).
MOCK_OTP_CODE=
# Signed-in sessions last this many days without a visit.
SESSION_DAYS=30

# SIP headers searched (in order) for the number the caller dialed.
# Check the logs of your first test call and adjust if needed.
SIP_CALLED_NUMBER_HEADERS=["X-Called-Number","Diversion","P-Called-Party-ID","To"]

# Seed data (python -m app.seed)
SEED_PHONE_NUMBER=+15555550100
SEED_ADMIN_EMAIL=admin@example.com
